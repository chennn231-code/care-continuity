{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://winwin.invalid/schemas/foundation-image-preparation-contract-v1.json",
  "title": "Foundation image preparation contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_type", "purpose", "mode", "required_inputs", "attempt_policy", "failure_policy", "drift_policy", "cleanup_policy", "acceptance_policy"],
  "properties": {
    "schema_version": {"const": "1"},
    "contract_type": {"const": "FOUNDATION_IMAGE_PREPARATION_CONTRACT"},
    "purpose": {"const": "IA-3A_SCHEMA_RUNTIME_VALIDATION"},
    "mode": {"const": "PRE_CACHED_APPROVED_DIGEST_ONLY"},
    "required_inputs": {"const": ["PASS_EFFECTIVE_PROFILE", "FROZEN_RESOURCE_EXPECTATION_INSTANCE", "COMPLETE_INDEPENDENT_IMAGE_APPROVAL_SET"]},
    "attempt_policy": {"type": "object", "additionalProperties": false, "required": ["attempts_per_image", "retry", "ordering", "stop_on_first_failure"], "properties": {"attempts_per_image": {"const": 1}, "retry": {"const": "FORBIDDEN"}, "ordering": {"const": "ROLE_ID_ASCENDING"}, "stop_on_first_failure": {"const": true}}},
    "failure_policy": {"type": "object", "additionalProperties": false, "required": ["partial_acquisition", "evidence"], "properties": {"partial_acquisition": {"const": "PRESERVE_AND_STOP"}, "evidence": {"const": "SANITIZED_IN_MEMORY_UNLESS_SEPARATELY_AUTHORIZED"}}},
    "drift_policy": {"type": "object", "additionalProperties": false, "required": ["tag_to_digest_change", "digest_unavailable", "approval_mismatch"], "properties": {"tag_to_digest_change": {"const": "FAIL"}, "digest_unavailable": {"const": "FAIL"}, "approval_mismatch": {"const": "FAIL"}}},
    "cleanup_policy": {"type": "object", "additionalProperties": false, "required": ["remove_partial", "remove_unapproved_local"], "properties": {"remove_partial": {"const": "FORBIDDEN"}, "remove_unapproved_local": {"const": "FORBIDDEN"}}},
    "acceptance_policy": {"type": "object", "additionalProperties": false, "required": ["tag_only", "local_match"], "properties": {"tag_only": {"const": "REJECTED"}, "local_match": {"const": "EXACT_APPROVED_IMMUTABLE_IDENTITY"}}}
  }
}
